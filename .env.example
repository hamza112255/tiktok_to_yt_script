# ════════════════════════════════════════════════
#  All Platforms → YouTube  —  Environment Variables
#  Copy to .env for local use, or set in Railway dashboard
# ════════════════════════════════════════════════

# ── YouTube API credentials (REQUIRED for upload) ─────────────────────────
# Step 1: Create a project at https://console.developers.google.com
# Step 2: Enable YouTube Data API v3
# Step 3: Create OAuth 2.0 credentials → Download client_secret.json
# Step 4: Run locally once: python refresh_youtube_token.py
# Step 5: Base64-encode both files for Railway:
#   python encode_for_railway.py
YOUTUBE_CLIENT_SECRET_B64=
YOUTUBE_TOKEN_JSON=

# ── Instagram session (REQUIRED for posts+reels on Railway) ───────────────
# Railway's IP is a datacenter IP — Instagram blocks unauthenticated requests.
# You MUST provide a real Instagram session cookie or posts/reels won't download.
#
# How to get your sessionid:
#   1. Log into Instagram in Chrome
#   2. Press F12 → Application tab → Cookies → https://www.instagram.com
#   3. Find the cookie named "sessionid" and copy its Value
#   4. Paste below (it looks like: 12345678%3AaBcDeFgHiJkLmN%3A12%3A...)
#
INSTAGRAM_SESSION_ID=
INSTAGRAM_USERNAME=your_instagram_username

# ── AudD audio copyright detection (OPTIONAL) ─────────────────────────────
# Free tier: 100 requests/day — https://audd.io/
# Leave empty to use keyword-only copyright detection.
AUDD_API_KEY=

# ── Feature toggles ────────────────────────────────────────────────────────
# Female detection is OFF by default on Railway (no GPU).
# Set to true only if running locally with sufficient RAM/GPU.
ENABLE_FEMALE_DETECTION=false
ENABLE_COPYRIGHT_CHECK=true

# ── Timing ─────────────────────────────────────────────────────────────────
CHECK_INTERVAL=600          # seconds between full scan cycles (600 = 10 min)
MAX_VIDEOS_PER_ACCOUNT=3    # newest N videos fetched per account per cycle
MAX_FILE_SIZE=100M           # skip files larger than this
